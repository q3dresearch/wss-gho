    website: "https://github.com/neldivad"
  - name: "q3dresearch"
    website: "https://github.com/q3dresearch"
license: CC-BY-4.0
keywords:
  - World Health Organization
  - Global Health Observatory
  - child mortality
  - Sustainable Development Goals
  - data revision
  - estimate vintages
  - reproducibility
  - point-in-time-data
